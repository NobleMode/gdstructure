{
  "name": "gdstructure",
  "displayName": "gdstructure",
  "description": " Godot-style res:// explorer for VS Code",
  "version": "0.4.3",
  "publisher": "NobleMode",
  "repository": {
    "type": "git",
    "url": "https://github.com/NobleMode/gdstructure"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:gdstructure",
    "workspaceContains:project.godot"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gdstructure.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "gdstructure.copyResPath",
        "title": "Copy res:// Path",
        "category": "Godot"
      },
      {
        "command": "gdstructure.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "Godot"
      },
      {
        "command": "gdstructure.delete",
        "title": "Delete",
        "category": "Godot"
      },
      {
        "command": "gdstructure.rename",
        "title": "Rename",
        "category": "Godot"
      },
      {
        "command": "gdstructure.pinResource",
        "title": "Pin to Favorites",
        "category": "Godot",
        "icon": "$(pin)"
      },
      {
        "command": "gdstructure.unpinResource",
        "title": "Unpin from Favorites",
        "category": "Godot",
        "icon": "$(pinned)"
      },
      {
        "command": "gdstructure.openInGodot",
        "title": "Open in Godot Editor",
        "category": "Godot",
        "icon": "$(plug)"
      },
      {
        "command": "gdstructure.reconnect",
        "title": "Reconnect to Godot Editor",
        "category": "Godot",
        "icon": "$(plug)"
      },
      {
        "command": "gdstructure.toggleAutoSync",
        "title": "Toggle Godot Selection Sync",
        "category": "Godot",
        "icon": "$(sync)"
      },
      {
        "command": "gdstructure.createFolder",
        "title": "New Folder",
        "category": "Godot",
        "icon": "$(new-folder)"
      },
      {
        "command": "gdstructure.createFile",
        "title": "New File",
        "category": "Godot",
        "icon": "$(new-file)"
      },
      {
        "command": "gdstructure.duplicate",
        "title": "Duplicate",
        "category": "Godot",
        "icon": "$(files)"
      },
      {
        "command": "gdstructure.copy",
        "title": "Copy",
        "category": "Godot"
      },
      {
        "command": "gdstructure.cut",
        "title": "Cut",
        "category": "Godot"
      },
      {
        "command": "gdstructure.paste",
        "title": "Paste",
        "category": "Godot"
      }
    ],
    "keybindings": [
      {
        "command": "gdstructure.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "view == gdstructure && viewItem =~ /folder|file|pinned-file/"
      },
      {
        "command": "gdstructure.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "view == gdstructure && viewItem =~ /folder|file|pinned-file/"
      },
      {
        "command": "gdstructure.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "view == gdstructure"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gdstructure.createFile",
          "group": "navigation",
          "when": "view == gdstructure"
        },
        {
          "command": "gdstructure.createFolder",
          "group": "navigation",
          "when": "view == gdstructure"
        },
        {
          "command": "gdstructure.toggleAutoSync",
          "group": "navigation",
          "when": "view == gdstructure"
        }
      ],
      "view/item/context": [
        {
          "command": "gdstructure.createFile",
          "when": "view == gdstructure && viewItem =~ /folder|file|pinned-file/",
          "group": "navigation"
        },
        {
          "command": "gdstructure.createFolder",
          "when": "view == gdstructure && viewItem =~ /folder|file|pinned-file/",
          "group": "navigation"
        },
        {
          "command": "gdstructure.copyResPath",
          "when": "view == gdstructure",
          "group": "navigation"
        },
        {
          "command": "gdstructure.revealInExplorer",
          "when": "view == gdstructure",
          "group": "navigation"
        },
        {
          "command": "gdstructure.openInGodot",
          "when": "view == gdstructure && !item.isDir",
          "group": "navigation"
        },
        {
          "command": "gdstructure.pinResource",
          "when": "view == gdstructure && viewItem == file",
          "group": "navigation"
        },
        {
          "command": "gdstructure.unpinResource",
          "when": "view == gdstructure && viewItem == pinned-file",
          "group": "navigation"
        },
        {
          "command": "gdstructure.rename",
          "when": "view == gdstructure",
          "group": "edit"
        },
        {
          "command": "gdstructure.duplicate",
          "when": "view == gdstructure",
          "group": "edit"
        },
        {
          "command": "gdstructure.copy",
          "when": "view == gdstructure",
          "group": "edit"
        },
        {
          "command": "gdstructure.cut",
          "when": "view == gdstructure",
          "group": "edit"
        },
        {
          "command": "gdstructure.paste",
          "when": "view == gdstructure && viewItem == folder",
          "group": "edit"
        },
        {
          "command": "gdstructure.delete",
          "when": "view == gdstructure",
          "group": "edit"
        }
      ]
    },
    "configuration": {
      "title": "Godot Structure",
      "properties": {
        "gdstructure.showGodotInternal": {
          "type": "boolean",
          "default": false,
          "description": "Show hidden Godot files (.import, .godot, etc.)"
        },
        "gdstructure.autoSyncSelection": {
          "type": "boolean",
          "default": false,
          "description": "Automatically select files in Godot Editor when clicked in VS Code"
        },
        "gdstructure.sortOrder": {
          "type": "string",
          "enum": [
            "godot",
            "alphabetical"
          ],
          "default": "godot",
          "description": "Sort order of files (Godot style: Scenes > Scripts > Resources, or simple Alphabetical)"
        },
        "gdstructure.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional file patterns to ignore (e.g. '*.tmp', 'junk/')"
        },
        "gdstructure.lspPort": {
          "type": "number",
          "default": 6005,
          "description": "Port to connect to Godot Editor (default 6005)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gdstructure-view",
          "title": "Godot",
          "icon": "resources/godot.svg"
        }
      ]
    },
    "views": {
      "gdstructure-view": [
        {
          "id": "gdstructure",
          "name": "Godot Files"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
