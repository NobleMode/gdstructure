{
  "name": "gdstructure",
  "displayName": "gdstructure",
  "description": " Godot-style res:// explorer for VS Code",
  "version": "0.0.1",
  "publisher": "myname",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:gdstructure",
    "workspaceContains:project.godot"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gdstructure.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "gdstructure.copyResPath",
        "title": "Copy res:// Path",
        "category": "Godot"
      },
      {
        "command": "gdstructure.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "Godot"
      },
      {
        "command": "gdstructure.delete",
        "title": "Delete",
        "category": "Godot"
      },
      {
        "command": "gdstructure.rename",
        "title": "Rename",
        "category": "Godot"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "gdstructure.copyResPath",
          "when": "view == gdstructure",
          "group": "navigation"
        },
        {
          "command": "gdstructure.revealInExplorer",
          "when": "view == gdstructure",
          "group": "navigation"
        },
        {
          "command": "gdstructure.rename",
          "when": "view == gdstructure",
          "group": "edit"
        },
        {
          "command": "gdstructure.delete",
          "when": "view == gdstructure",
          "group": "edit"
        }
      ]
    },
    "configuration": {
      "title": "Godot Structure",
      "properties": {
        "gdstructure.showGodotInternal": {
          "type": "boolean",
          "default": false,
          "description": "Show hidden Godot files (.import, .godot, etc.)"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "gdstructure",
          "name": "Godot Files"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
